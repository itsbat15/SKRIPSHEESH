<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="diagram_kerangka_ta" name="Gambar 1.1 Diagram Alir Kerangka Pengerjaan Tugas Akhir">
    <mxGraphModel dx="1200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="980" background="#ffffff">
      <root>
        <mxCell id="0" />
